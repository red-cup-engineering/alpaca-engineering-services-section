[Unit]
Description=Alpaca paper trading loop (Esther Davis)
# Every order is admitted by the venue execution transport from the broker's
# current account and position observations.  Do not add an out-of-band
# high-water-mark gate here: balance resets and transfers are not losses.
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-web-engineering-services-section/services/web-platform-services-section/services/web2-platform-services-section/services/web2-financial-platform-services-section/services/web2-financial-brokerage-platform-services-section/services/alpaca-services-section/services/alpaca-esther-paper-trading-loop
EnvironmentFile=/home/emsenn/info/.env
ExecStart=/usr/bin/node src/run-loop.mjs
StandardOutput=journal
StandardError=journal
