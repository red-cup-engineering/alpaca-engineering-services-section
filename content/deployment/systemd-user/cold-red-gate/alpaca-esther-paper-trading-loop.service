[Unit]
Description=Alpaca paper trading loop (Esther Davis) on Cold Red Gate
# Current broker observations at the execution boundary, not a historical
# high-water mark, determine whether a new order is admissible.
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/emsenn/561-group/services/alpaca-esther-paper-trading-loop
EnvironmentFile=%h/.config/alpaca-esther-paper.env
ExecStart=/home/emsenn/561-group/services/alpaca-esther-paper-trading-loop/node_modules/.bin/alpaca-esther-paper-trading-loop
StandardOutput=journal
StandardError=journal
