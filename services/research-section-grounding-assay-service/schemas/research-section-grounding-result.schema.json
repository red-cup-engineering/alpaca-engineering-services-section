{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:rsc-quiescent:research-section-grounding-result:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "admittedSections", "residues", "four", "truthEstablished", "allocationEstablished", "executionEstablished", "effect"],
  "properties": {
    "type": { "const": "ResearchSectionGroundingAssay" },
    "version": { "const": 1 },
    "admittedSections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["provider", "role", "symbol", "horizonDays", "expectedExcessReturn", "confidence", "observedAt", "evidenceReferences", "basisFactIds", "status"],
        "properties": {
          "provider": { "type": "string" }, "role": { "type": "string" }, "symbol": { "type": "string" },
          "horizonDays": { "type": "integer", "minimum": 1 }, "expectedExcessReturn": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "observedAt": { "type": "string", "format": "date-time" },
          "evidenceReferences": { "type": "array", "items": { "type": "string" } },
          "basisFactIds": { "type": "array", "items": { "type": "string" } },
          "status": { "const": "model-judgment-admitted-for-descent-not-truth" }
        }
      }
    },
    "residues": { "type": "array", "items": { "$ref": "urn:schema:rsc-quiescent:research-section-grounding-refusal:1" } },
    "four": { "type": "object", "additionalProperties": false, "required": ["positiveEvidence", "negativeEvidence"], "properties": { "positiveEvidence": { "type": "boolean" }, "negativeEvidence": { "type": "boolean" } } },
    "truthEstablished": { "const": false }, "allocationEstablished": { "const": false }, "executionEstablished": { "const": false }, "effect": { "const": "assay-only" }
  }
}
