{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:rsc-quiescent:research-section-grounding-request:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["committee", "allowedEvidenceReferences", "evidenceFacts", "universe", "horizonDays", "observedAt"],
  "properties": {
    "committee": { "$ref": "urn:schema:rsc-quiescent:investment-research-result:1" },
    "allowedEvidenceReferences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceFacts": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } } },
    "universe": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z.-]{0,9}$" } },
    "horizonDays": { "type": "integer", "minimum": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "maximumAbsoluteExpectedReturn": { "type": "number", "exclusiveMinimum": 0 }
  }
}
