{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:schema:rsc-quiescent:strategy-program-synthesis-result:1",
  "type": "object", "additionalProperties": false,
  "required": ["type", "version", "contextProduct", "incumbentProgram", "generation", "candidates", "residues", "providerDistinct", "executionEstablished", "promotionEstablished", "effect"],
  "properties": {
    "type": { "const": "StrategyProgramPopulation" }, "version": { "const": 1 },
    "contextProduct": { "type": "string" }, "incumbentProgram": { "type": "string" }, "generation": { "type": "integer", "minimum": 0 },
    "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["index", "provider", "candidate", "receipt"], "properties": {
      "index": { "type": "integer", "minimum": 0 }, "provider": { "type": "string", "minLength": 1 }, "receipt": { "type": ["string", "null"] },
      "candidate": { "$ref": "#/$defs/candidate" }
    } } },
    "residues": { "type": "array", "items": { "$ref": "urn:schema:rsc-quiescent:strategy-program-synthesis-refusal:1" } },
    "providerDistinct": { "type": "boolean" }, "executionEstablished": { "const": false }, "promotionEstablished": { "const": false }, "effect": { "const": "untrusted-generated-programs-only" }
  },
  "$defs": { "candidate": { "type": "object", "additionalProperties": false, "required": ["strategySource", "falsifiers"], "properties": {
    "strategySource": { "type": "string", "minLength": 32, "maxLength": 64000 },
    "falsifiers": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string", "minLength": 1 } }
  } } }
}
