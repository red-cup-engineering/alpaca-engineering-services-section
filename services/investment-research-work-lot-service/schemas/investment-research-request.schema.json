{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:rsc-quiescent:investment-research-request:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contextProduct", "customerActor", "universe", "horizonDays", "maxTokensPerSeat", "evidenceReferences", "evidenceFacts"],
  "properties": {
    "contextProduct": { "type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$" },
    "customerActor": { "type": "string", "minLength": 1 },
    "universe": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z.-]{0,9}$" } },
    "horizonDays": { "type": "integer", "minimum": 1 },
    "maxTokensPerSeat": { "type": "integer", "minimum": 256, "maximum": 4096 },
    "evidenceReferences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "value"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "metric": { "type": "string", "minLength": 1 },
          "value": { "type": "number" }
        }
      }
    },
    "routingProfile": { "type": "string", "enum": ["bounded", "extended"] },
    "difficulty": { "type": "number", "minimum": 0, "maximum": 1 },
    "maximumWallClockMs": { "type": "integer", "minimum": 1 }
  }
}
