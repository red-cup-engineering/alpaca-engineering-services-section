{
  "name": "@rsc-quiescent/brokerage-control-api-federation",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Scalable customer-wallet-funded market in metered brokerage-control APIs.",
  "exports": {
    ".": "./src/contract-kernel.mjs",
    "./market-runtime": "./src/market-runtime.mjs",
    "./virtuals-runtime": "./src/virtuals-runtime.mjs",
    "./union-runtime": "./src/union-runtime.mjs",
